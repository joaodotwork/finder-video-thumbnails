#!/usr/bin/env bash
# finder-video-thumbnails
# Generate macOS Finder thumbnails for video files using ffmpeg + fileicon.

set -euo pipefail

# Resolve the script's real directory (following symlinks) so we can locate
# the package.json that ships alongside it.
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$( cd -P "$( dirname "$_src" )" && pwd )"
  _src="$( readlink "$_src" )"
  [[ $_src != /* ]] && _src="$_dir/$_src"
done
_script_dir="$( cd -P "$( dirname "$_src" )" && pwd )"
_pkg_json="$_script_dir/../package.json"

read_version() {
  if [[ -f "$_pkg_json" ]]; then
    grep '"version"' "$_pkg_json" | head -1 \
      | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'
  else
    echo "unknown"
  fi
}

print_version() {
  echo "finder-video-thumbnails $(read_version)"
}

print_help() {
  cat <<'EOF'
finder-video-thumbnails — Generate macOS Finder thumbnails for video files

Usage:
  finder-video-thumbnails [options] <folder> [seek_seconds]

Arguments:
  <folder>        folder to process (recursive)
  seek_seconds    timestamp (in seconds) to grab the frame from (default: 1)

Options:
  -h, --help      show this help and exit
  -V, --version   print version and exit
      --force     re-generate icons even if one is already set

Examples:
  finder-video-thumbnails ~/Movies
  finder-video-thumbnails ~/Movies 5
  finder-video-thumbnails --force ~/Movies

Supported formats:
  .mov  .mp4  .m4v  .avi  .mkv  .webm

Requires:
  ffmpeg, fileicon (brew install ffmpeg fileicon)
EOF
}

force=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -V|--version)
      print_version
      exit 0
      ;;
    --force)
      force=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      echo "run 'finder-video-thumbnails --help' for usage" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  echo "usage: finder-video-thumbnails [options] <folder> [seek_seconds]" >&2
  echo "run 'finder-video-thumbnails --help' for details" >&2
  exit 1
fi

folder="$1"
seek="${2:-1}"

if [[ ! -d "$folder" ]]; then
  echo "error: not a directory: $folder" >&2
  exit 1
fi

for cmd in ffmpeg fileicon; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "error: '$cmd' not found on PATH" >&2
    echo "  install with: brew install $cmd" >&2
    exit 1
  fi
done

videos=()
while IFS= read -r -d '' f; do
  videos+=("$f")
done < <(find "$folder" -type f \( \
  -iname '*.mov' -o \
  -iname '*.mp4' -o \
  -iname '*.m4v' -o \
  -iname '*.avi' -o \
  -iname '*.mkv' -o \
  -iname '*.webm' \) -print0)

if [[ ${#videos[@]} -eq 0 ]]; then
  echo "no video files found in: $folder"
  exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

done_count=0
skip_count=0
fail_count=0
i=0

for video in "${videos[@]}"; do
  name="${video#$folder/}"
  ((i++))

  if [[ $force -eq 0 ]] && fileicon test "$video" >/dev/null 2>&1; then
    echo "skip  $name (already has icon)"
    ((skip_count++))
    continue
  fi

  thumb="$tmpdir/thumb_$i.png"
  if ! ffmpeg -y -ss "$seek" -i "$video" -frames:v 1 -update 1 \
        -vf "scale=512:512:force_original_aspect_ratio=decrease,format=rgba,pad=512:512:(ow-iw)/2:(oh-ih)/2:color=black@0" \
        "$thumb" </dev/null >/dev/null 2>&1; then
    echo "FAIL  $name (ffmpeg)"
    ((fail_count++))
    continue
  fi

  if ! fileicon set "$video" "$thumb" >/dev/null 2>&1; then
    echo "FAIL  $name (fileicon)"
    ((fail_count++))
    continue
  fi

  echo "ok    $name"
  ((done_count++))
done

echo
echo "done: $done_count   skipped: $skip_count   failed: $fail_count"
